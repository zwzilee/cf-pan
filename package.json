{
  "name": "pan-r2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "多 Cloudflare 账号 R2/S3 聚合网盘",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "render:config": "node scripts/render-config.mjs",
    "deploy:env": "node scripts/render-config.mjs && wrangler deploy --config .wrangler-deploy.toml",
    "typecheck": "tsc --noEmit",
    "db:init": "wrangler d1 execute pan_r2 --file=schema.sql --remote",
    "db:init:local": "wrangler d1 execute pan_r2 --file=schema.sql --local"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "typescript": "^5.9.3",
    "wrangler": "^3.90.0"
  }
}
